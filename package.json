{
  "name": "forex-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ingest:dry": "npx tsx --tsconfig tsconfig.tsx.json --env-file-if-exists=.env.local scripts/ingest-dry.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "drill:fxstreet": "npx tsx --tsconfig tsconfig.tsx.json --env-file-if-exists=.env.local scripts/drill-fxstreet-down.ts",
    "fixtures": "npx tsx --tsconfig tsconfig.tsx.json scripts/capture-fixtures.ts",
    "check:supabase": "npx tsx --tsconfig tsconfig.tsx.json --env-file=.env.local scripts/check-supabase.ts",
    "backtest": "npx tsx --tsconfig tsconfig.tsx.json --env-file-if-exists=.env.local scripts/backtest.ts",
    "check:ai": "npx tsx --tsconfig tsconfig.tsx.json --env-file=.env.local scripts/check-ai.ts",
    "verify:board": "npx tsx --tsconfig tsconfig.tsx.json --env-file-if-exists=.env.local scripts/board-stability.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "fast-xml-parser": "^5.10.1",
    "lightweight-charts": "^5.2.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
