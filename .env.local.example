# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and paste your keys where marked.
#
#   cp .env.local.example .env.local
#
# .env.local is gitignored. Nothing here is required to run the app — with an
# empty file it still starts, ingests all free no-key sources, and scores.
# ---------------------------------------------------------------------------


# === AI (optional) =========================================================
# Used ONLY for plain-English commentary and classification. Scores are
# rule-based and never depend on the model — delete this whole section and
# every number on the dashboard is identical.

OPENAI_API_KEY=<PASTE_HERE_API_KEY>

# Which model to use. gpt-4o-mini is the cheap default; the AI layer is
# summarization of figures we already computed, so a small model is plenty.
OPENAI_MODEL=gpt-5.5

# 'openai' | 'ollama' | 'none'
# Leave unset to auto-detect: uses OpenAI when the key above is real, otherwise
# falls back to local Ollama, otherwise disables AI entirely.
AI_PROVIDER=openai

# Local Ollama, for free key-free development. You already have llama3.2,
# mistral and llama2 installed.
# AI_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2


# === AI Analysis page (optional) ===========================================
# The /ai chat runs on OpenRouter's FREE Nemotron model. The server refuses
# any model id that does not end in ":free", checks OpenRouter's own price
# list before the first request, never sends paid options (web search plugin,
# fallback models), and switches itself off if a response ever reports a cost.
# Free models allow 20 requests a minute and 50 a day (1,000 a day once 10
# credits have ever been bought); one question uses one or two requests.
#
# Get a key at openrouter.ai -> Keys. If requests fail with "no endpoints
# matching your data policy", allow free endpoints in OpenRouter's privacy
# settings. Keep the account balance at zero or above: a negative balance
# blocks free models too (HTTP 402).

OPENROUTER_API_KEY=<PASTE_HERE_OPENROUTER_KEY>
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# The passphrase that unlocks /ai in a browser. The site is public, so without
# it anyone could spend the free daily allowance. Unset = the page is off.
AI_ACCESS_KEY=<PASTE_HERE_A_PASSPHRASE_OF_YOUR_CHOICE>


# === Telegram alerts (optional) ============================================
# Without these, alerts still appear in the in-app feed — they just do not
# reach your phone.
#
# Setup:
#   1. Message @BotFather on Telegram, send /newbot, follow the prompts.
#   2. Paste the token it gives you below.
#   3. Message your new bot once (it cannot start a conversation with you).
#   4. Open https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates and copy
#      the numeric `chat.id` from the response.

TELEGRAM_BOT_TOKEN=<PASTE_HERE_BOT_TOKEN>
TELEGRAM_CHAT_ID=<PASTE_HERE_CHAT_ID>


# === Storage (optional locally, REQUIRED in production) ====================
# Without Supabase the app uses an in-memory store. That is fine for local dev,
# but on Vercel each serverless invocation gets its own memory, so alert dedupe
# cannot work and the same alert would be re-sent on every cron run.
#
# Setup:
#   1. Create a free project at supabase.com.
#   2. Run lib/db/schema.sql in the SQL editor.
#   3. Settings -> API -> copy the URL and the service_role key.
#
# The service_role key bypasses row-level security. Server-side only — never
# prefix it with NEXT_PUBLIC_.

SUPABASE_URL=<PASTE_HERE_SUPABASE_URL>
SUPABASE_SERVICE_KEY=<PASTE_HERE_SUPABASE_SERVICE_KEY>


# === Cron protection (REQUIRED in production) ==============================
# Shared secret guarding /api/ingest. Without it that route is public and
# anyone can trigger ingest runs against your quotas.
# Generate one with:  openssl rand -hex 32

CRON_SECRET=<PASTE_HERE_RANDOM_SECRET>


# === Offline mode ==========================================================
# Serves captured fixtures instead of hitting the network. Useful for UI work,
# for demos, and for checking the app still renders when everything is down.
# USE_FIXTURES=true
